[Unit]
Description=FastAPI application
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/overpass-api-proxy
Environment=PORT=8001
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/overpass-api-proxy/.venv/bin/uvicorn main:app --host 0.0.0.0 --port ${PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
